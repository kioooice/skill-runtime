{
  "task": "Convert pull request review comments into a grouped maintainer cleanup plan.",
  "task_id": "maintainer_review_cleanup_demo",
  "session_id": "demo_review_cleanup",
  "skill_args": {
    "input_path": "demo/maintainer_review_cleanup/review_comments.json",
    "output_path": "demo/maintainer_review_cleanup/expected_cleanup_plan.md"
  },
  "actions": [
    {
      "tool_name": "read_json",
      "tool_input": {
        "path": "demo/maintainer_review_cleanup/review_comments.json"
      },
      "observation": "Read 3 pull request review comments for PR #42.",
      "status": "success"
    },
    {
      "tool_name": "group_review_comments",
      "tool_input": {
        "group_by": [
          "severity",
          "file"
        ],
        "required_severity": "must_fix",
        "follow_up_severity": "follow_up"
      },
      "observation": "Grouped 2 required fixes and 1 follow-up documentation item.",
      "status": "success"
    },
    {
      "tool_name": "write_text",
      "tool_input": {
        "path": "demo/maintainer_review_cleanup/expected_cleanup_plan.md"
      },
      "observation": "Wrote a maintainer cleanup plan with required fixes, follow-up documentation, verification commands, and merge decision guidance.",
      "status": "success",
      "artifacts": [
        "demo/maintainer_review_cleanup/expected_cleanup_plan.md"
      ]
    }
  ],
  "result": {
    "status": "completed",
    "outputs": [
      "demo/maintainer_review_cleanup/expected_cleanup_plan.md"
    ]
  },
  "final_status": "success",
  "artifacts": [
    "demo/maintainer_review_cleanup/expected_cleanup_plan.md"
  ]
}
